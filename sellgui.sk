# ====================================================================
# BOX 1 OF 4: SYSTEM INITIALIZATION AND CORE CONFIGURATION LAYOUT
# ====================================================================
options:
    prefix: &a&lSELL &8»&7

command /sellgui:
    permission: sellgui.use
    permission message: {@prefix} &cYou do not have permission to use the Sell GUI!
    trigger:
        set {_gui} to a chest inventory with 2 rows named "&0Place items here to sell"
        set slot 9 of {_gui} to red stained glass pane named "&c&lCANCEL TRANSACTION" with lore "&7Click here to cancel and||&7return all your items safely."
        set slot 17 of {_gui} to lime stained glass pane named "&a&lCONFIRM &e&lSALE" with lore "&7Click here to sell all||&7eligible items instantly.||&bEstimated Value: &e$0.00"
        set metadata value "in_sellgui" of player to true
        open {_gui} to player

on inventory click:
    if metadata value "in_sellgui" of player is true:
        if index of clicked slot is 9:
            cancel event
            close inventory of player
            stop
        if index of clicked slot is 17:
            cancel event
            set {_payout} to metadata value "sellgui_estimate" of player
            if {_payout} is not set:
                set {_payout} to 0
            if {_payout} is greater than 0:
                loop 9 times:
                    set slot (loop-number - 1) of current inventory of player to air
                add {_payout} to player's balance
                send "{@prefix} &aSuccess! You sold your items for &e$%{_payout}%&a!" to player
                delete metadata value "sellgui_estimate" of player
                close inventory of player
            else:
                send "{@prefix} &cYou don't have any valuable items placed in the GUI yet!" to player
            stop
        if index of clicked slot is greater than 8:
            if index of clicked slot is less than 17:
                cancel event
                stop
        wait 1 tick
        set {_live_total} to 0
        loop 9 times:
            set {_slot_num} to loop-number - 1
            set {_item} to slot {_slot_num} of current inventory of player
            if {_item} is not air:
                set {_amount} to item amount of {_item}
                set {_price} to 0
                set {_name} to name of {_item}
                set {_raw} to "%type of {_item}%"
                if {_name} is set:
                    if {_name} contains "Legendary Mace":
                        set {_price} to 20000.00
                    else if {_name} contains "Hunting Spear":
                        set {_price} to 4000.00
                    else if {_name} contains "Wind Charge":
                        set {_price} to 0.10
                    else if {_name} contains "1.16 Netherite Helmet":
                        set {_price} to 30000.00
                    else if {_name} contains "1.16 Netherite Chestplate":
                        set {_price} to 30000.00
                    else if {_name} contains "1.16 Netherite Leggings":
                        set {_price} to 30000.00
                    else if {_name} contains "1.16 Netherite Boots":
                        set {_price} to 30000.00
                    else if {_name} contains "1.16 Netherite Sword":
                        set {_price} to 20000.00
                if {_price} is 0:
                    if {_raw} contains "bookshelf":
                        set {_price} to 29.78
                    else if {_raw} contains "hay":
                        set {_price} to 11.82
                    else if {_raw} contains "magma":
                        set {_price} to 8.41
                    else if {_raw} contains "packed ice":
                        set {_price} to 3.38
                    else if {_raw} contains "slime":
                        set {_price} to 11.82

# ====================================================================
# BOX 2 OF 4: STRUCTURAL MATERIAL PACKETS AND STAINED BLOCKS
# ====================================================================
                    else if {_raw} contains "snow":
                        set {_price} to 3.15
                    else if {_raw} contains "soul sand":
                        set {_price} to 2.50
                    else if {_raw} contains "stone":
                        set {_price} to 0.18
                    else if {_raw} contains "tnt":
                        set {_price} to 26.65
