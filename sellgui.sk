                if {_price} is greater than 0:
                    add ({_price} * {_amount}) to {_live_total}
        set metadata value "sellgui_estimate" of player to {_live_total}
        set slot 17 of current inventory of player to lime stained glass pane named "&a&lCONFIRM &e&lSALE" with lore "&7Click here to sell all||&7eligible items instantly.||&bEstimated Value: &e$%{_live_total}%"

on inventory close:
    if metadata value "in_sellgui" of player is true:
        delete metadata value "in_sellgui" of player
        delete metadata value "sellgui_estimate" of player
        loop 9 times:
            set {_slot_num} to loop-number - 1
            set {_item} to slot {_slot_num} of current inventory of player
            if {_item} is not air:
                give {_item} to player
